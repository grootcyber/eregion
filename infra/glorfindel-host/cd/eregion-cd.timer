# Every 5 minutes, one pass of the CD of Imladris (H1). Installed disabled: `make
# imladris-cd-check` first (dry run), then `make imladris-cd-enable`.
[Unit]
Description=Eregion CD every 5 minutes (H1)

[Timer]
OnBootSec=5min
OnUnitActiveSec=5min
RandomizedDelaySec=30s

[Install]
WantedBy=timers.target
