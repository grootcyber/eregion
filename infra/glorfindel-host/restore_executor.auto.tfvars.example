# FS1g (#1127) : l'application de l'exécuteur de restore — à copier en restore_executor.auto.tfvars
# (ignoré par git), sur le poste de l'opérateur seulement, puis `make imladris-plan`, relu
# (restore_executor.tf, docs/operations.md, « L'exécuteur de restore »), puis `make imladris-up` sans YES.
restore_executor_enabled = true

# La partie publique du certificat, sa clé tirée sur l'hôte — jamais la clé ici, jamais un secret.
# Vide : aucun identifiant, l'exécuteur ne peut pas se connecter.
restore_executor_certificate = ""

# Le groupe du coffre, s'il n'est pas celui du banc (vide : le seul groupe du banc).
restore_vault_resource_group = ""
